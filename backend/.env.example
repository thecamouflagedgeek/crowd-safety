# ---------------------------------------------------------------------------
# Public Safety CV Backend - example configuration
#
# Copy to `.env` and fill in the keys. `.env` is gitignored; NEVER commit real
# keys, and never move these into the Flutter or React apps. Every credential
# here is server-side only.
# ---------------------------------------------------------------------------

# --------------------------------------------------------------- LLM providers
# The chatbot never depends on a single model. Providers are tried in order
# (Gemini, then Grok) and within each provider every model is tried in order.
# The chain stops at the first model that returns usable text. If a model is
# retired, rate-limited, times out or errors, the next one is tried.
#
# Leave GEMINI_MODELS / XAI_MODELS EMPTY to use the built-in current chains:
#   Gemini: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash,
#           gemini-3.5-flash, gemini-3.5-flash-lite
#   Grok:   grok-4.7, grok-4.6, grok-4.3
#
# A comma-separated override REPLACES that provider chain completely, e.g.
#   GEMINI_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODELS=

XAI_API_KEY=
XAI_MODELS=
XAI_BASE_URL=https://api.x.ai/v1

# Per-model ceiling (seconds) and a hard ceiling for the whole chain so a chat
# request can never hang. On timeout the chain simply moves to the next model.
LLM_MODEL_TIMEOUT_SECONDS=15
LLM_TOTAL_BUDGET_SECONDS=45

# ------------------------------------- public-safety evidence retrieval (news)
# These are EVIDENCE sources used by /verify, /news and /sources. Retrieved items
# are always labelled REPORTED and can never verify a claim on their own.
SERPAPI_KEY=
NEWS_API_KEY=
NEWS_COUNTRY=in
NEWS_LANG=en
NEWS_WINDOW_HOURS=72
NEWS_MAX_RESULTS=5
NEWS_TIMEOUT_SECONDS=6

# ------------------------------------------------------------------- routing
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_ENABLED=1

# ------------------------------------------------- computer vision / detection
# Primary detector is YOLO; the pipeline degrades to OpenCV HOG / MOG2 if the
# weights or `ultralytics` are unavailable, and the API still starts.
CV_USE_YOLO=1
YOLO_MODEL=yolo26n.pt
CV_PROCESS_FPS=8
CV_LOOP_VIDEO=1
